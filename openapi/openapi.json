{
  "components": {
    "schemas": {
      "AccountProvider": {
        "enum": [
          "KAKAO"
        ],
        "title": "AccountProvider",
        "type": "string"
      },
      "AccountResponse": {
        "description": "현재 인증된 Mosemo 계정의 공개 정보입니다.",
        "properties": {
          "account_id": {
            "description": "Mosemo 계정의 고유 식별자입니다.",
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "created_at": {
            "description": "계정이 생성된 시각입니다.",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "last_authenticated_at": {
            "description": "외부 인증 제공자를 통해 마지막으로 인증한 시각입니다.",
            "format": "date-time",
            "title": "Last Authenticated At",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/AccountProvider",
            "description": "계정 인증에 사용한 외부 인증 제공자입니다."
          }
        },
        "required": [
          "account_id",
          "provider",
          "created_at",
          "last_authenticated_at"
        ],
        "title": "AccountResponse",
        "type": "object"
      },
      "ApiErrorResponse": {
        "description": "Mosemo API가 통제된 오류를 반환할 때 사용하는 응답입니다.",
        "properties": {
          "detail": {
            "description": "클라이언트에 공개하는 오류 메시지입니다.",
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ApiErrorResponse",
        "type": "object"
      },
      "RequestValidationErrorResponse": {
        "description": "FastAPI가 요청 입력값 검증 실패 시 반환하는 응답입니다.",
        "properties": {
          "detail": {
            "description": "요청에서 발견된 입력값 검증 오류 목록입니다.",
            "items": {
              "$ref": "#/components/schemas/ValidationErrorDetail"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "RequestValidationErrorResponse",
        "type": "object"
      },
      "TokenRequest": {
        "description": "일회용 인증 코드를 Mosemo 액세스 토큰으로 교환하는 요청입니다.",
        "properties": {
          "code": {
            "description": "Kakao 로그인 callback에서 macOS 앱으로 전달한 일회용 인증 코드입니다.",
            "title": "Code",
            "type": "string"
          },
          "code_verifier": {
            "description": "로그인 요청의 code_challenge를 생성할 때 사용한 43~128자의 PKCE code verifier입니다.",
            "title": "Code Verifier",
            "type": "string"
          },
          "grant_type": {
            "const": "authorization_code",
            "description": "토큰 발급 방식이며 authorization_code만 허용합니다.",
            "title": "Grant Type",
            "type": "string"
          }
        },
        "required": [
          "grant_type",
          "code",
          "code_verifier"
        ],
        "title": "TokenRequest",
        "type": "object"
      },
      "TokenResponse": {
        "description": "Mosemo API 인증에 사용하는 액세스 토큰 응답입니다.",
        "properties": {
          "access_token": {
            "description": "Authorization 헤더에 사용할 Mosemo 액세스 토큰입니다.",
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "액세스 토큰이 발급 시점부터 유효한 시간(초)입니다.",
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "description": "액세스 토큰의 인증 방식이며 Bearer로 고정됩니다.",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "ValidationErrorDetail": {
        "description": "요청에서 발견된 개별 입력값 검증 오류입니다.",
        "properties": {
          "ctx": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "검증 오류 메시지를 구성하는 추가 정보입니다.",
            "title": "Ctx"
          },
          "input": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "description": "검증에 실패한 입력값입니다.",
            "title": "Input"
          },
          "loc": {
            "description": "오류가 발생한 요청 영역과 필드의 경로입니다.",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "description": "입력값이 유효하지 않은 이유입니다.",
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "description": "검증 오류 유형을 식별하는 코드입니다.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationErrorDetail",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Mosemo가 발급한 Bearer 액세스 토큰입니다.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Mosemo API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accounts/me": {
      "get": {
        "description": "Bearer 액세스 토큰으로 인증된 Mosemo 계정 정보를 조회합니다.",
        "operationId": "accountsGetMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            },
            "description": "현재 인증된 계정의 공개 정보입니다."
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "Invalid or expired access token"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "액세스 토큰이 누락되었거나 유효하지 않거나 만료되었거나, 토큰의 계정이 존재하지 않습니다.",
            "headers": {
              "WWW-Authenticate": {
                "description": "클라이언트가 사용해야 하는 인증 방식입니다.",
                "schema": {
                  "const": "Bearer",
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "현재 계정 조회",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/v1/auth/kakao/callback": {
      "get": {
        "description": "Kakao 인증 결과와 로그인 요청의 state 및 PKCE 쿠키를 검증합니다. 성공하면 일회용 인증 코드를, 실패하면 공개 오류 코드를 macOS 앱에 전달합니다.",
        "operationId": "authKakaoCallback",
        "parameters": [
          {
            "description": "Kakao가 인증 성공 시 전달한 authorization code입니다.",
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Kakao가 인증 성공 시 전달한 authorization code입니다.",
              "title": "Code"
            }
          },
          {
            "description": "로그인 요청과 callback을 연결하고 CSRF를 방지하는 state 값입니다.",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "로그인 요청과 callback을 연결하고 CSRF를 방지하는 state 값입니다.",
              "title": "State"
            }
          },
          {
            "description": "Kakao가 인증 실패 또는 취소 시 전달한 오류 코드입니다.",
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Kakao가 인증 실패 또는 취소 시 전달한 오류 코드입니다.",
              "title": "Error"
            }
          },
          {
            "description": "Kakao가 전달한 상세 오류 설명입니다. 서버는 민감 정보 노출을 방지하기 위해 사용하지 않습니다.",
            "in": "query",
            "name": "error_description",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Kakao가 전달한 상세 오류 설명입니다. 서버는 민감 정보 노출을 방지하기 위해 사용하지 않습니다.",
              "title": "Error Description"
            }
          },
          {
            "description": "로그인 시작 시 서버가 저장한 OAuth state 쿠키입니다.",
            "in": "cookie",
            "name": "kakao_oauth_state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "로그인 시작 시 서버가 저장한 OAuth state 쿠키입니다.",
              "title": "Kakao Oauth State"
            }
          },
          {
            "description": "로그인 시작 시 서버가 저장한 PKCE code challenge 쿠키입니다.",
            "in": "cookie",
            "name": "kakao_oauth_pkce_challenge",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "로그인 시작 시 서버가 저장한 PKCE code challenge 쿠키입니다.",
              "title": "Kakao Oauth Pkce Challenge"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "인증 결과를 macOS 앱에 전달하는 리다이렉트 응답입니다.",
            "headers": {
              "Cache-Control": {
                "description": "응답을 저장하지 않도록 no-store로 설정됩니다.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Location": {
                "description": "성공 시 code, 실패 시 access_denied 또는 authentication_failed를 포함하는 macOS custom scheme URI입니다.",
                "schema": {
                  "format": "uri",
                  "type": "string"
                }
              },
              "Pragma": {
                "description": "이전 HTTP 캐시와의 호환을 위해 no-cache로 설정됩니다.",
                "schema": {
                  "const": "no-cache",
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "state 및 PKCE challenge 쿠키를 즉시 만료시킵니다.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "Invalid Kakao OAuth state"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "state 또는 PKCE challenge 쿠키가 유효하지 않습니다.",
            "headers": {
              "Cache-Control": {
                "description": "응답을 저장하지 않도록 no-store로 설정됩니다.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Pragma": {
                "description": "이전 HTTP 캐시와의 호환을 위해 no-cache로 설정됩니다.",
                "schema": {
                  "const": "no-cache",
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "state 및 PKCE challenge 쿠키를 즉시 만료시킵니다.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationErrorResponse"
                }
              }
            },
            "description": "Callback 파라미터 또는 쿠키의 형식이 잘못되었습니다."
          }
        },
        "summary": "Kakao 로그인 callback 처리",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/kakao/login": {
      "get": {
        "description": "macOS 앱이 생성한 PKCE code challenge를 저장하고 Kakao 인증 화면으로 이동시킵니다.",
        "operationId": "authKakaoLogin",
        "parameters": [
          {
            "description": "macOS 앱이 code_verifier로부터 S256 방식으로 생성한 PKCE code challenge입니다.",
            "in": "query",
            "name": "code_challenge",
            "required": true,
            "schema": {
              "description": "macOS 앱이 code_verifier로부터 S256 방식으로 생성한 PKCE code challenge입니다.",
              "pattern": "^[A-Za-z0-9_-]{43}$",
              "title": "Code Challenge",
              "type": "string"
            }
          },
          {
            "description": "PKCE code challenge 생성 방식이며 S256으로 고정됩니다.",
            "in": "query",
            "name": "code_challenge_method",
            "required": true,
            "schema": {
              "const": "S256",
              "description": "PKCE code challenge 생성 방식이며 S256으로 고정됩니다.",
              "title": "Code Challenge Method",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Kakao 인증 화면으로 이동하는 리다이렉트 응답입니다.",
            "headers": {
              "Cache-Control": {
                "description": "응답을 저장하지 않도록 no-store로 설정됩니다.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Location": {
                "description": "Kakao 인증 화면의 URL입니다.",
                "schema": {
                  "format": "uri",
                  "type": "string"
                }
              },
              "Pragma": {
                "description": "이전 HTTP 캐시와의 호환을 위해 no-cache로 설정됩니다.",
                "schema": {
                  "const": "no-cache",
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "10분 동안 유지되는 HttpOnly state 및 PKCE challenge 쿠키입니다. 운영 환경에서는 Secure 속성도 사용합니다.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationErrorResponse"
                }
              }
            },
            "description": "PKCE 쿼리 파라미터가 누락되었거나 형식이 잘못되었습니다."
          }
        },
        "summary": "Kakao 로그인 시작",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/token": {
      "post": {
        "description": "Kakao 로그인 callback에서 발급한 일회용 인증 코드와 PKCE code verifier를 검증한 뒤 Mosemo 액세스 토큰을 발급합니다.",
        "operationId": "authExchangeToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Mosemo Bearer 액세스 토큰입니다.",
            "headers": {
              "Cache-Control": {
                "description": "응답을 저장하지 않도록 no-store로 설정됩니다.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Pragma": {
                "description": "이전 HTTP 캐시와의 호환을 위해 no-cache로 설정됩니다.",
                "schema": {
                  "const": "no-cache",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "Invalid or expired authorization code"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "일회용 인증 코드가 없거나 만료되었거나 이미 사용되었거나, PKCE code verifier가 유효하지 않습니다."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationErrorResponse"
                }
              }
            },
            "description": "요청 본문의 필수 필드 또는 grant_type이 유효하지 않습니다."
          }
        },
        "summary": "액세스 토큰 발급",
        "tags": [
          "auth"
        ]
      }
    }
  }
}
