MOSEMO_ENV=local

BATCH_TOPIC=activities.registration-requested
BATCH_BOOTSTRAP_SERVERS=localhost:9092
BATCH_GROUP_ID=mosemo.activity-batches
# Creation only: changing this never resizes an existing topic.
BATCH_TOPIC_PARTITIONS=2

DB_DATABASE=mosemo_local
DB_USER=mosemo
DB_PASSWORD=local-only-fake-password
DB_HOST=localhost
DB_PORT=5432

KAKAO_REST_API_KEY=fake-kakao-rest-api-key
KAKAO_CLIENT_SECRET=fake-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback

AUTH_JWT_SECRET_KEY=local-only-fake-jwt-secret-key-do-not-use-in-production
AUTH_JWT_ISSUER=mosemo
AUTH_JWT_AUDIENCE=mosemo-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=86400
AUTH_AUTHORIZATION_CODE_TTL_SECONDS=60
AUTH_MACOS_CALLBACK_URI=com.example.mosemo:/auth/callback

# Pydantic AI provider docs: https://ai.pydantic.dev/models/openai/
# https://ai.pydantic.dev/models/google/
# The batch jobs process (label proposals) needs the matching key for its LABEL_MODEL provider:
# openai:<model-id> uses OPENAI_API_KEY; google:<model-id> uses GOOGLE_API_KEY.
OPENAI_API_KEY=fake-openai-api-key
GOOGLE_API_KEY=fake-google-api-key
LABEL_MODEL=openai:fake-model
