{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && MOSEMO_AGENT=claude uv run --locked python .codex/hooks/post_edit_feedback.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && MOSEMO_AGENT=claude uv run --locked python .codex/hooks/stop_gate.py",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && MOSEMO_AGENT=claude uv run --locked python .codex/hooks/review_metrics.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
