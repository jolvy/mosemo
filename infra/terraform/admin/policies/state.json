{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListApplicationState",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::mosemo-tfstate-${account_id}-ap-southeast-2"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "mosemo/lab/",
            "mosemo/lab/*",
            "env:/"
          ]
        }
      }
    },
    {
      "Sid": "ReadAndWriteApplicationState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::mosemo-tfstate-${account_id}-ap-southeast-2/mosemo/lab/terraform.tfstate"
      ]
    },
    {
      "Sid": "ManageApplicationStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::mosemo-tfstate-${account_id}-ap-southeast-2/mosemo/lab/terraform.tfstate.tflock"
      ]
    }
  ]
}
